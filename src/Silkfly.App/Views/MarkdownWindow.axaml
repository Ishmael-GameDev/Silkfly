<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Silkfly.App.ViewModels"
        xmlns:controls="using:Silkfly.App.Controls"
        xmlns:loc="using:Silkfly.App.Localization"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
        xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        x:Class="Silkfly.App.Views.MarkdownWindow"
        x:DataType="vm:MarkdownDialogViewModel"
        Title="{Binding Title}"
        Width="760" Height="560" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding $parent[Window].Close}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1" PointerPressed="OnTitlePointerPressed">
      <Grid ColumnDefinitions="*,Auto" Margin="14,0,0,0" Height="40">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
          <TextBlock Classes="caption" Text="{Binding Subtitle}" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Classes="caption close" Click="OnCloseClick"
                ToolTip.Tip="{loc:Str Readme_Close}">
          <controls:GlyphIcon Width="16" Height="16" StrokeThickness="1.5" Data="{StaticResource Caption.Close}" />
        </Button>
      </Grid>
    </Border>

    <md:MarkdownScrollViewer x:Name="Viewer" Grid.Row="1" Margin="18,10,6,10"
                             Markdown="{Binding Markdown}" IsVisible="{Binding HasMarkdown}">
      <md:MarkdownScrollViewer.Styles>
        <Style Selector="ctxt|CTextBlock">
          <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ctxt|CTextBlock.Heading1">
          <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="ctxt|CTextBlock.Heading2">
          <Setter Property="FontSize" Value="19" />
        </Style>
        <Style Selector="ctxt|CTextBlock.Heading3">
          <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="ctxt|CCode">
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
          <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        </Style>
        <Style Selector="ctxt|CHyperlink">
          <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        </Style>
        <Style Selector="ctxt|CHyperlink:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Border.CodeBlock">
          <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="TextBlock.CodeBlock">
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
      </md:MarkdownScrollViewer.Styles>
    </md:MarkdownScrollViewer>

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                IsVisible="{Binding !HasMarkdown}">
      <ProgressBar IsIndeterminate="True" Width="160" IsVisible="{Binding IsLoading}" />
      <TextBlock Classes="secondary" Text="{loc:Str Readme_Loading}" HorizontalAlignment="Center" IsVisible="{Binding IsLoading}" />
      <TextBlock Classes="secondary" Text="{Binding Message}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
    </StackPanel>

    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
      <Button HorizontalAlignment="Right" Content="{loc:Str Readme_Close}" Click="OnCloseClick" IsDefault="True" />
    </Border>
  </Grid>
</Window>
