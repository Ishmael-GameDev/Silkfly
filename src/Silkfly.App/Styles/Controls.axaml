<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Silkfly.App.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <Style Selector=":is(Button), ComboBox, ToggleSwitch, TextBox">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource AccentHoverBrush}" CornerRadius="8" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.icon, Button.caption">
    <Setter Property="AutomationProperties.Name" Value="{Binding $self.(ToolTip.Tip)}" />
  </Style>

  <Style Selector=":is(Button)">
    <Setter Property="ToolTip.ShowDelay" Value="300" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Button.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.caption">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <Style Selector="RadioButton.tab">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTab}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}" RowDefinitions="*,Auto">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center">
            <ContentPresenter.Transitions>
              <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
              </Transitions>
            </ContentPresenter.Transitions>
          </ContentPresenter>
          <Border Name="Underline" Grid.Row="1" Height="2" CornerRadius="1" Margin="22,0,22,2"
                  Background="{DynamicResource AccentBrush}" Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                <ThicknessTransition Property="Margin" Duration="0:0:0.18" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.tab:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:pointerover /template/ Border#Underline">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="RadioButton.tab:pressed">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:focus-visible /template/ Border#Underline">
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#Underline">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Margin" Value="8,0,8,2" />
  </Style>

  <Style Selector="ComboBox.header">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="RadioButton.chip">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ChipBorder"
                Background="{TemplateBinding Background}"
                CornerRadius="2"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton.chip:checked">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.card.hoverable:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentPressedBrush}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
  </Style>

  <Style Selector="controls|GlyphIcon">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.update">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnWarningBrush}" />
  </Style>
  <Style Selector="Button.update:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F2B65A" />
    <Setter Property="BorderBrush" Value="#F2B65A" />
    <Setter Property="Foreground" Value="{DynamicResource OnWarningBrush}" />
  </Style>
  <Style Selector="Button.update:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C9872A" />
  </Style>

  <Style Selector="Button.small">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="0,0,4,4" />
  </Style>
  <Style Selector="Border.tag > TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.tag.warning">
    <Setter Property="Background" Value="#3A2A14" />
  </Style>
  <Style Selector="Border.tag.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="TextBlock.outdated">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <Style Selector="ListBox.cards">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:focus-visible Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:pointerover Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>

  <Style Selector="ListBox:not(.cards) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ListBox:not(.cards) ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="ToggleButton.chevron">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.chevron:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.chevron:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.chevron:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>

  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="2" />
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.8" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.banner">
    <Setter Property="Background" Value="#2E1A12" />
    <Setter Property="BorderBrush" Value="#5A3A1A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Border.update">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,5,10,5" />
  </Style>

  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="12,8,8,8" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #80000000" />
  </Style>
  <Style Selector="Border.toast.success">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.toast.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.toast.error">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="22,18" />
    <Setter Property="BoxShadow" Value="0 8 30 0 #A0000000" />
  </Style>

  <Style Selector="Grid.row">
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="Grid.row > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
